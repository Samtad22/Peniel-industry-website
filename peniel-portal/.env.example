# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the browser. Used for invites and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Where invite / password-reset links send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email notifications (Resend). Leave empty to keep emails off; they are then
# logged as "skipped" on the Settings page.
RESEND_API_KEY=
EMAIL_FROM="Peniel Portal <portal@penielindustry.org>"
